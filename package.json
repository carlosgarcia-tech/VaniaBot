{
  "name": "vaniabot",
  "version": "7.0.1",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "tsx src/vania.ts",
    "qr": "tsx src/vania.ts qr",
    "code": "tsx src/vania.ts code",
    "dev": "NODE_ENV=development tsx watch --clear-screen=false --exclude='node_modules' --exclude='dist' --exclude='.git' --exclude='*.log' src/index.ts",
    "build": "tsc",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "prepare": "husky",
    "postinstall": "node -e \"try{const p=require('./node_modules/whatsapp-rust-bridge/package.json');if(!p.main){p.main='./dist/index.js';if(!p.exports['.'].require)p.exports['.'].require='./dist/index.js';require('fs').writeFileSync('./node_modules/whatsapp-rust-bridge/package.json',JSON.stringify(p,null,4)+'\\n')}}catch(e){console.log('[postinstall] whatsapp-rust-bridge patch skipped:',e.message)}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "typescript"
  ],
  "author": "Carlos G",
  "license": "MIT",
  "dependencies": {
    "@napi-rs/canvas": "^0.1.98",
    "@resvg/resvg-js": "^2.6.2",
    "baileys": "^7.0.0-rc13",
    "axios": "^1.13.5",
    "canvas": "^3.2.1",
    "chalk": "^5.6.2",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "file-type": "^19.6.0",
    "groq-sdk": "^0.37.0",
    "helmet": "^8.1.0",
    "jimp": "^1.6.0",
    "lru-cache": "^11.2.6",
    "mathjs": "^15.1.1",
    "megajs": "^1.3.9",
    "mongodb": "^7.1.0",
    "mumaker": "^2.0.0",
    "node-webpmux": "^3.2.1",
    "pdf-lib": "^1.17.1",
    "pino": "^9.5.0",
    "qrcode-terminal": "^0.12.0",
    "redis": "^5.11.0",
    "sql.js": "^1.14.1",
    "wa-sticker-formatter": "^4.4.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mathjs": "^9.4.1",
    "@types/node": "^22.19.17",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}

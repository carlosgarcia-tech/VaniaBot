BOT_NAME=OrbitBot
BOT_PREFIX=.

# Owner IDs (comma separated)
# Supports plain numbers, standard JIDs and channel JIDs
# ⚠️ REPLACE with your own WhatsApp IDs
OWNERS=your_number_or_jid_here
OWNER_JIDS=your_number_or_jid_here

# Authentication method
# true = Pairing code | false = QR code
USE_PAIRING_CODE=true

# Phone number (with country code)
# Format: +[country code][number]
# ⚠️ REPLACE with your WhatsApp number
PHONE_NUMBER=+5215512345678

# Session path
SESSION_PATH=./orbitsession

# Max reconnect attempts (optimized: 10)
MAX_RECONNECT_ATTEMPTS=10

# Automatic reconnection
AUTO_RECONNECT=true

# Database type: json | sqlite | mongodb
DB_TYPE=sqlite

# MongoDB URI (only if DB_TYPE=mongodb)
# DB_URI=mongodb://localhost:27017/orbit

# SQLite database path (only if DB_TYPE=sqlite)
# DB_PATH=./data/orbit.db

# Enable in-memory cache
CACHE_ENABLED=true

# Anti-spam (rate limiting middleware)
ANTI_SPAM=true

# Runtime environment
NODE_ENV=production

# Log level (error | warn | info | debug)
LOG_LEVEL=info

# Connection timeout (ms) - Default: 90000
# CONNECTION_TIMEOUT=90000

# Keep-alive interval (ms) - Default: 25000
# KEEP_ALIVE_INTERVAL=25000

# Retry delay (ms) - Default: 200
# RETRY_DELAY=200

# Max DB cache size - Default: 10000
# DB_CACHE_MAX_SIZE=10000

# DB save delay (ms) - Default: 2000
# DB_SAVE_DELAY=2000

# Forced DB save interval (ms) - Default: 30000
# DB_FORCE_SAVE_INTERVAL=30000

# Max commands per minute per user
MAX_COMMANDS_PER_MINUTE=10

# Max media file size (bytes)
# Default: 50MB = 52428800
MAX_MEDIA_SIZE=52428800

# Auto-read messages
AUTO_READ=false

# Reply to own messages
SELF_REPLY=false

# === AI Configuration ===
# Groq API key (required for AI features, get free at https://console.groq.com/keys)
GROQ_API_KEY=groq_api_key

# Gemini API key for AI fallback (optional, get free at https://aistudio.google.com/apikey)
# GEMINI_API_KEY=your_gemini_api_key

# Ollama URL for local AI fallback (optional, default: http://localhost:11434)
# OLLAMA_URL=http://localhost:11434

# Redis configuration (optional, for Docker environments)
# USE_REDIS=true
# REDIS_URL=redis://redis:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Groq AI API (get free at https://console.groq.com/keys)
# GROQ_API_KEY=your_api_key_here

# DeepAI API (get at https://deepai.org)
# DEEPAI_API_KEY=your_api_key_here

# Restart configuration (orbit.ts)
# MAX_QUICK_RESTARTS=5
# RESTART_WINDOW_MS=120000
# MAX_RESTART_DELAY_MS=30000
# FORCE_RESTART_WAIT_MS=60000

# Rate limiting
# MAX_COMMANDS_PER_MINUTE=10
# GROUP_RATE_LIMIT_MAX_MESSAGES=30
# GROUP_RATE_LIMIT_WINDOW_MS=60000
# FLOOD_MAX_MESSAGES_PER_SECOND=3
# FLOOD_WINDOW_MS=1000

# 1. Copy this file as .env
# 2. Set BOT_NAME, OWNERS and PHONE_NUMBER
# 3. Run: npm start
# 4. Scan the QR or enter the pairing code
# 5. Done!

# Full documentation: see Readme.md
# Contributions: see CONTRIBUTING.md
# Support: contact the developer
